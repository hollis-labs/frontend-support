{
  "name": "@hollis-labs/ade-agent",
  "version": "0.1.0",
  "description": "The page's side of a conversation with an agent host: turns, the event stream, and running the page's own tools.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
