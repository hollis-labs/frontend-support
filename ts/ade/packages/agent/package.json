{
  "name": "@hollis-labs/ade-agent",
  "version": "0.1.0",
  "description": "The page's side of a conversation with an agent host: turns, the event stream, and running the page's own tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/frontend-support.git",
    "directory": "ts/ade/packages/agent"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "npm run build"
  },
  "homepage": "https://github.com/hollis-labs/frontend-support/tree/main/ts/ade/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/frontend-support/issues"
  }
}
