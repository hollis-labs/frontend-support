{
  "name": "@hollis-labs/ade-core",
  "version": "0.1.0",
  "description": "The contract between a person, an agent and an application over shared state: surfaces, observations, anchors, actions, attention and guides.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
