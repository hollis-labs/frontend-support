{
  "name": "@hollis-labs/ade-core",
  "version": "0.1.0",
  "description": "The contract between a person, an agent and an application over shared state: surfaces, observations, anchors, actions, attention and guides.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/frontend-support.git",
    "directory": "ts/ade/packages/core"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  },
  "homepage": "https://github.com/hollis-labs/frontend-support/tree/main/ts/ade/packages/core#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/frontend-support/issues"
  }
}
