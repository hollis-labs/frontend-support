{
  "name": "@hollis-labs/ade-react",
  "version": "0.1.0",
  "description": "React bindings for ADE: surfaces, the attention layer, the guide bar and a plain agent panel.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@hollis-labs/ade-agent": "0.1.0",
    "@hollis-labs/ade-core": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0"
  }
}
