{
  "name": "@hollis-labs/kit-voice",
  "version": "0.0.0",
  "description": "Voice kit — speech input, microphone and voice selection, transcript and audio playback. Props down, messages up: no transport, no STT/TTS, no opinion about where audio goes.",
  "keywords": [
    "react",
    "voice",
    "speech",
    "design-system",
    "base-ui"
  ],
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/frontend-support.git",
    "directory": "ts/design-kit/packages/kit-voice"
  },
  "homepage": "https://github.com/hollis-labs/frontend-support/tree/main/ts/design-kit/packages/kit-voice#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/frontend-support/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./audio-player": {
      "types": "./dist/src/audio-player/index.d.ts",
      "import": "./dist/audio-player/index.js"
    },
    "./source.css": "./src/styles/source.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "@base-ui/react": "^1.3.0",
    "lucide-react": "^1.7.0",
    "media-chrome": "^4.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "media-chrome": {
      "optional": true
    }
  },
  "dependencies": {
    "@hollis-labs/design-components": "^0.5.0",
    "@hollis-labs/design-tokens": "^0.5.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.7.0",
    "media-chrome": "^4.17.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9"
  },
  "private": true
}
