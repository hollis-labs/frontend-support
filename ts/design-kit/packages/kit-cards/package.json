{
  "name": "@hollis-labs/kit-cards",
  "version": "0.0.0",
  "private": true,
  "description": "Cards kit — the Envelope chassis, card shapes, answerable cards, a headless lifecycle engine and a renderer registry. Props down, outcomes up: no transport, no wire.",
  "keywords": [
    "react",
    "cards",
    "design-system",
    "base-ui",
    "approval",
    "forms"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hollis-labs/frontend-support.git",
    "directory": "ts/design-kit/packages/kit-cards"
  },
  "homepage": "https://github.com/hollis-labs/frontend-support/tree/main/ts/design-kit/packages/kit-cards#readme",
  "bugs": {
    "url": "https://github.com/hollis-labs/frontend-support/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/src/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./registry": {
      "types": "./dist/src/registry/index.d.ts",
      "import": "./dist/registry/index.js"
    },
    "./source.css": "./src/styles/source.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "demo:build": "vite build --config demo/vite.config.ts",
    "e2e": "npm run demo:build && playwright test -c e2e/playwright.config.ts"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "@base-ui/react": "^1.3.0",
    "lucide-react": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@hollis-labs/design-bindings": "^0.1.0",
    "@hollis-labs/design-components": "^0.5.0",
    "@hollis-labs/design-tokens": "^0.5.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.3.0",
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "vite": "5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.1.9",
    "@hollis-labs/eslint-config-design": "^0.5.0",
    "@playwright/test": "^1.64.1",
    "typescript-eslint": "^8.58.0",
    "@tailwindcss/vite": "^4.2.2",
    "tailwindcss": "^4.2.2"
  }
}
